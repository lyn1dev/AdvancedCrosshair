{
  "schemaVersion": 1,
  "id": "advancedcrosshair",
  "version": "${version}",
  "name": "AdvancedCrosshair",
  "description": "Changes the color of your crosshair based on your ability to hit or critical hit an enemy player.",
  "authors": [
    "lynzl"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/adv-crosshair",
    "issues": "https://github.com/lyn1dev/AdvancedCrosshair/issues",
    "sources": "https://github.com/Lyn1dev/AdvancedCrosshair"
  },
  "license": "CC0-1.0",
  "icon": "assets/modid/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "advancedcrosshair.AdvancedCrosshairClient"
    ],
    "modmenu": [
      "advancedcrosshair.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "advancedcrosshair.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.9",
    "minecraft": ">=1.21.9 <1.21.12",
    "java": ">=21",
    "yet_another_config_lib_v3": ">=3.8.0"
  },
  "suggests": {
    "fabric-api": "*"
  }
}
